-- SeiunEngine 示例模块：lib/utils.lua
-- English: SeiunEngine example module: lib/utils.lua
--
-- 可以被 require 或 import 加载：
--   local u = require("lib.utils")     -- 带缓存，模块只执行一次
--   local u = import("lib/utils.lua")  -- 每次重新执行（include 语义）
-- Can be loaded via require or import:
--   local u = require("lib.utils")     -- cached, runs once
--   local u = import("lib/utils.lua")  -- re-executed every time (include)

local M = {}

M.double = function(x)
	return x * 2
end

M.greet = function(name)
	return "Hello, " .. name .. "!"
end

-- import 演示用：每次 import 都会 +1，require 不会
-- English: for the import demo — +1 on every import, not on require
M.counter = 0
M.bump = function()
	M.counter = M.counter + 1
	return M.counter
end

return M
